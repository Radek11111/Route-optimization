
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

enum UserRole {
  MEMBER
  ADMIN
  GUEST
}

enum RouteStatus {
   DRAFT
  READY
  ARCHIVED
}

enum SolutionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?

  role UserRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  routes Route[]
  @@index([email])
}

model Route {
  id        String   @id @default(uuid())

  name      String?
  description String?

  status RouteStatus @default(DRAFT)

  vehicleCount Int @default(1)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depotPointId String? @unique
  depotPoint   Point? @relation("RouteDepot", fields: [depotPointId], references: [id])

  points Point[] @relation("RoutePoints")

  solutions Solution[]

   workStartMinutes       Int
  workEndMinutes         Int
  maxWorkDurationMinutes Int
  breakAfterMinutes      Int?
  breakDurationMinutes   Int?
  returnToDepot          Boolean @default(false)

  ratePerKm Float?

  @@index([userId])
   @@index([depotPointId])
}



model Point {
  id        String   @id @default(uuid())

  routeId String
  route Route @relation("RoutePoints", fields: [routeId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float

  name      String? @db.VarChar(255)

  serviceTimeMinutes Int @default(0)
  priority Int @default(1)

  timeWindowStart Int?
  timeWindowEnd   Int?

 updatedAt DateTime @updatedAt

  depotForRoutes Route[] @relation("RouteDepot")

  createdAt DateTime @default(now())

  routeStops RouteStop[]
  unassignedPoints UnassignedPoint[]

 @@index([routeId])
}

model Solution {
  id        String   @id @default(uuid())

  totalCost Float @default(0)
  feasible Boolean

  status SolutionStatus @default(PENDING)

  travelTime Float @default(0)
  workTimePenalty Float @default(0)
  timeWindowPenalty Float @default(0)
  returnToDepotPenalty Float @default(0)
  priorityPenalty Float @default(0)

  naiveDistanceKm Float?
  savedDistanceKm Float?
  savedPercent Int?

  routeId    String 
  route      Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
 vehicleRoutes VehicleRoute[]

 updatedAt DateTime @updatedAt

 totalDistanceKm Float?
  estimatedPrice  Float?

 unassignedPoints UnassignedPoint[]
 @@index([routeId, createdAt])
}

model VehicleRoute {
  id        String   @id @default(uuid())

  vehicleIndex Int

  totalServiceTime Float?
  totalTravelTime Float?
  totalWorkTime Float?
  feasible Boolean?

  solutionId String
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  totalDistanceKm Float?
  estimatedPrice  Float?
  stops RouteStop[]

@@index([solutionId])
 @@unique([solutionId, vehicleIndex])
}

model RouteStop {
  id        String   @id @default(uuid())

  order     Int

  vehicleRouteId String
  vehicleRoute   VehicleRoute @relation(fields: [vehicleRouteId], references: [id], onDelete: Cascade)

  pointId   String 
  point     Point  @relation(fields: [pointId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

 @@index([pointId])
@@index([vehicleRouteId])
}

model UnassignedPoint {
  id String @id @default(uuid())

  solutionId String
  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  pointId String
  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)

  reason String?

  createdAt DateTime @default(now())

  @@unique([solutionId, pointId])
  @@index([solutionId])
}
